#!/usr/bin/env bash
# Runs idf.py inside Espressif's image so nothing has to be installed on the host.
# Set PORT=/dev/ttyACM0 to pass the board through for flashing.
set -euo pipefail

image=${IDF_IMAGE:-espressif/idf:v5.5.1}
root=$(cd "$(dirname "$0")/.." && pwd)

args=(--rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$root":/project:z -w /project)

# SELinux blocks the container from opening the tty unless its label is dropped.
if [ -n "${PORT:-}" ]; then
    args+=(--device "$PORT" --group-add "$(getent group dialout | cut -d: -f3)" --security-opt label=disable)
fi

exec docker run "${args[@]}" "$image" bash -lc 'idf.py "$@"' _ "$@"
